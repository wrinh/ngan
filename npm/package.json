{
  "name": "@wrinh/ngan",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Praat-compatible acoustic analysis & TD-PSOLA engine (intensity, pitch/filtered-AC, formants, spectrogram/Mel/Bark, MFCC, PowerCepstrogram/CPPS, HNR, jitter/shimmer, voice breaks, TextGrid, Web Worker & chunked long-audio streaming) compiled from MoonBit to WebAssembly GC.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrinh/ngan.git",
    "directory": "npm"
  },
  "keywords": [
    "praat",
    "phonetics",
    "speech-analysis",
    "acoustics",
    "pitch",
    "formants",
    "spectrogram",
    "web-audio",
    "audioworklet",
    "wasm-gc"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worklet": {
      "types": "./dist/worklet-processor.d.ts",
      "default": "./dist/worklet-processor.js"
    },
    "./worker": {
      "types": "./dist/worker-entry.d.ts",
      "default": "./dist/worker-entry.js"
    },
    "./ngan.wasm": "./dist/ngan.wasm"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "node ./scripts/copy-wasm.mjs --build",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "node --test ./test/sdk.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
